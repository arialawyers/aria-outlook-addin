<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6f0c8a5e-2b7d-4f4e-9c1a-a71a3b5d9e21</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>Aria Lawyers</ProviderName>
  <DefaultLocale>en-AU</DefaultLocale>
  <DisplayName DefaultValue="Aria Lawyers Management System" />
  <Description DefaultValue="Save emails, attachments and time to Aria Lawyers matters." />
  <IconUrl DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://arialawyers.com.au" />
  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://arialawyers21.sharepoint.com</AppDomain>
    <AppDomain>https://arialawyers.github.io</AppDomain>
  </AppDomains>
  <Hosts><Host Name="Mailbox" /></Hosts>
  <Requirements>
    <Sets><Set Name="Mailbox" MinVersion="1.8" /></Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://arialawyers.github.io/aria-outlook-addin/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://arialawyers.github.io/aria-outlook-addin/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8"><bt:Set Name="Mailbox" /></bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="aria.readGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="aria.saveButton">
                    <Label resid="buttonLabel" />
                    <Supertip>
                      <Title resid="buttonLabel" />
                      <Description resid="buttonTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="aria.composeGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="aria.composeButton">
                    <Label resid="buttonLabel" />
                    <Supertip>
                      <Title resid="buttonLabel" />
                      <Description resid="composeTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
          <MobileFormFactor>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="aria.mobileGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="MobileButton" id="aria.mobileSave">
                  <Label resid="buttonLabel" />
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="icon25" />
                    <bt:Image size="25" scale="2" resid="icon48" />
                    <bt:Image size="25" scale="3" resid="icon80" />
                    <bt:Image size="32" scale="1" resid="icon32" />
                    <bt:Image size="32" scale="2" resid="icon64" />
                    <bt:Image size="32" scale="3" resid="icon128" />
                    <bt:Image size="48" scale="1" resid="icon48" />
                    <bt:Image size="48" scale="2" resid="icon128" />
                    <bt:Image size="48" scale="3" resid="icon128" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-16.png" />
          <bt:Image id="icon25" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-25.png" />
          <bt:Image id="icon32" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-32.png" />
          <bt:Image id="icon48" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-48.png" />
          <bt:Image id="icon64" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-64.png" />
          <bt:Image id="icon80" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-80.png" />
          <bt:Image id="icon128" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/assets/icon-128.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="taskpaneUrl" DefaultValue="https://arialawyers.github.io/aria-outlook-addin/taskpane.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="Aria Lawyers" />
          <bt:String id="buttonLabel" DefaultValue="Save to matter" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="composeTip" DefaultValue="Choose the matter for this email. It is saved to that matter automatically after you send it." />
          <bt:String id="buttonTip" DefaultValue="Save this email (and optionally its attachments and time) to an Aria Lawyers matter." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
