{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Aria Lawyers client intake receiver: receives the client's intake answers and saves them in SharePoint (Aria Intake Responses)."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "aria-intake-receiver"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "siteUrl": {
      "type": "string",
      "defaultValue": "https://arialawyers21.sharepoint.com/sites/AriaManagement"
    }
  },
  "variables": {
    "connName": "aria-sharepoint"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Aria SharePoint (authorise after deployment)",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "siteUrl": {
              "type": "String",
              "defaultValue": "https://arialawyers21.sharepoint.com/sites/AriaManagement"
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "method": "POST"
              }
            }
          },
          "actions": {
            "Read_answers": {
              "type": "Compose",
              "inputs": "@json(string(triggerBody()))",
              "runAfter": {}
            },
            "Save_to_SharePoint": {
              "type": "ApiConnection",
              "runAfter": {
                "Read_answers": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('siteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('Aria Intake Responses'))}/items",
                "body": {
                  "Title": "Intake @{outputs('Read_answers')?['matterNumber']}",
                  "MatterNumber": "@{outputs('Read_answers')?['matterNumber']}",
                  "ClientData": "@{string(outputs('Read_answers'))}"
                }
              }
            },
            "Reply": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Save_to_SharePoint": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Access-Control-Allow-Origin": "*",
                  "Content-Type": "application/json"
                },
                "body": {
                  "ok": true
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "sharepointonline": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connName'))]",
                "connectionName": "[variables('connName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
              }
            }
          },
          "siteUrl": {
            "value": "[parameters('siteUrl')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "next": {
      "type": "string",
      "value": "Open the API connection 'aria-sharepoint', choose Edit API connection > Authorize, sign in, Save. Then open the Logic App, Logic app designer, click the trigger and copy the HTTP URL into Aria: Settings > Intake form."
    }
  }
}